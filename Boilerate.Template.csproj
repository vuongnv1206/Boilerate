<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Boilerate.CleanArchitecture.Template</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Boilerate contributors</Authors>
    <Description>Backend template with table permissions, sessions and SQL Server/PostgreSQL persistence.</Description>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="src/**;tests/**;.config/**;.template.config/**;scripts/**;.github/workflows/**;Boilerate.Template.csproj;README.md;plan.md;THIRD_PARTY_NOTICES.md;Boilerate.sln;Directory.Build.props;Directory.Build.targets;Directory.Packages.props;global.json;stylecop.json;.editorconfig;.gitignore;compose.yaml;.dockerignore"
             Exclude="**/bin/**;**/obj/**;**/Logs/**;**/logs/**;**/Files/**;**/__pycache__/**;**/*.pyc;**/*.user;**/*.env;**/*.pfx;**/*.nupkg"
             Pack="true" PackagePath="content/%(Identity)" />
    <!-- An extensionless PackagePath is interpreted as a directory by NuGet. -->
    <Content Include="Dockerfile" Pack="true" PackagePath="content/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
